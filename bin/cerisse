#!/bin/bash
case  $1 in
    clean )
	tput setaf 2
	echo " ... removing plt*, *.tmp  files"
	tput sgr0
    rm -rf ./plot/plt*
	rm -rf ./plot/*.vtk
	rm -f *.tmp
	rm -f *.visit
	rm -f *.log
	rm -f screen
	rm -rf Backtrace*
	rm -rf chk00000
	rm -rf chk00000.*	
	echo -e "\\033[1;32m  dir clean and ready to run \\033[0m"
	case $2 in
		all )
		tput setaf 2
        	echo " ... removing building dirs, *.log, checkpoints and *.ex " 
		tput sgr0
		rm -rf tmp_build_dir
		rm -rf *.ex
		rm -rf chk*
		rm -rf plot
		rm -rf *.log
		echo -e "\\033[1;32m  and ready to compile\\033[0m"
		;;
		*)
		esac
	;;
	visit )
	tput setaf 2
	echo " ...  creating movie.visit file"
	tput sgr0
	ls -1 plot/plt*/Header | tee movie.visit	
	echo -e "\\033[1;32m  DONE  \\033[0m"
	;;
	run )
	tput setaf 2
	echo " ...  running cerisse MPI "
	tput sgr0
     
	run_exe=""
	if [[ -x ./main3d.gnu.MPI.ex ]]; then
    	run_exe=main3d.gnu.MPI.ex
    	dim="3D"
	elif [[ -x ./main2d.gnu.MPI.ex ]]; then
    	run_exe=main2d.gnu.MPI.ex
    	dim="2D"
	elif [[ -x ./main1d.gnu.MPI.ex ]]; then
    	run_exe=main1d.gnu.MPI.ex
    	dim="1D"
	else
    	echo "❌ No main?.gnu.MPI.ex executable found!"
    	exit 1
	fi

	echo "🚀 Running $dim simulation with ./$run_exe" 

    case $2 in
		screen )
		echo " piping output to screen file "  
		mpirun --use-hwthread-cpus $run_exe inputs	> screen &
		;;
		*)
		mpirun --use-hwthread-cpus $run_exe inputs
		esac
	echo -e "\\033[1;32m  DONE  \\033[0m"
	;;
	plot )
	tput setaf 2
	echo " ...  quick x-momentum 2d plot"
	tput sgr0
	python ../../bin/plot2d.py
	echo -e "\\033[1;32m  DONE  \\033[0m"
	;;
	check )
	tput setaf 2
	echo " checking if cerisse is broken "
	tput sgr0
	case $2 in
		basic )
		echo "       .... basic flow "
		bash checktest.sh
		tput sgr0
		echo -e "\\033[1;32m  DONE  \\033[0m"
		;;
		chem )
		echo "       .... with PelePhysics and chemistry "
		tput sgr0
		bash checktestchem.sh
		tput sgr0
		echo -e "\\033[1;32m  DONE  \\033[0m"
		;;
		*)
		echo "check [option] not recognised.."
		echo "basic/chem"
		esac
	;;
	backup )
    tput setaf 2
    echo " backing up.. in $2 "
	tput sgr0
    mkdir $2
	cp *.H $2
	cp *.h $2
	cp *.cpp $2
	cp *.log $2
	cp inputs $2	
	cp GNUmakefile $2
	cp *.py $2
	mv chk* $2
	mv screen $2
	mv *.visit $2
	mv plot $2/
	echo -e "\\033[1;32m  DONE  \\033[0m"
	;;
	stepinfo )
	tput setaf 2
	echo " displaying last steps in screen file"
	tput sgr0
	echo " -----------------------------------"
	grep "STEP" screen | tail -n 6
	echo " -----------------------------------"
	tput setaf 2
	echo " information summary "
	tput sgr0
	echo " -----------------------------------"	
	cost=$(grep "Coarse TimeStep time:" screen | tail -n 5 | awk '{ sum += $6 } END {print sum }')
    mpis=$(grep "MPI initialized with [0-9]\+ MPI processes" screen | awk '{print $4}')
	maxkb=$(grep "FAB kilobyte spread across MPI nodes" screen | tail -n 1 | sed -E 's/.*\.\.\. ([0-9]+).*/\1/')
	# Calculate average cost per time step
	avg_cost=$(echo "$cost / 5" | bc -l)
	# Convert kB to MB
	maxmb=$(echo "$maxkb / 1024" | bc -l)	
	# Total memory in MB
	totalmb=$(echo "$mpis * $maxkb / 1024" | bc -l)	

	# Extract 40 lines after the last "REGRID" line
	regrid_block=$(awk '/REGRID/{line=NR} END{print line}' screen)
	tail -n +"$regrid_block" screen | head -n 40 > tmp_regrid_block.txt

	# Parse those lines to collect only the last "Advanced ... cells" line per level
	awk '
	/Advanced [0-9]+ cells/ {
    for (i = 1; i <= NF; i++) {
        if ($i == "Level") level = $(i+1)
        if ($i == "Advanced") cells[level] = $(i+1)
    }
	}
	END {
    total = 0
    for (l in cells) total += cells[l]
    printf "Total cell count (after last REGRID): %'\''d\n", total
	}' tmp_regrid_block.txt

	# Clean up
	rm tmp_regrid_block.txt

	# Output
	printf " Number of MPI processes       : %d\n" "$mpis"
	printf " Max memory FAB in MPI         : %d kB (%.2f MB)\n" "$maxkb" "$maxmb"
	printf " Max total FAB memory          : %.2f MB (%.2f GB)\n" "$totalmb" "$(echo "$totalmb / 1024" | bc -l)"
	printf " Average Cost Coarse Time Step : %.2f secs\n" "$avg_cost"
	echo " -----------------------------------"
	echo -e "\\033[1;32m  DONE  \\033[0m"
	;;
    *)
	echo "option not recognised.."
	echo "clean[all]/visit/plot/backup[dirname]/check/stepinfo"

	echo "Usage: $0 [option]"
	echo ""
	echo "Options:"
	echo "  clean         Remove temporary and output files generated by previous runs:"
	echo "                  - Deletes: screen, *.plt, *.hdf5, Backtrace.* chk00000"
	echo "                  - Cleans AMReX-related output and restart files if present"
	echo "                  - Keeps source files and executables intact"
	echo "  clean all     Perform a full cleanup of the directory:"
	echo "                  - Includes everything in 'clean'"
	echo "                  - Also removes: executables (main?.gnu.MPI.ex), object files (*.o), Make.package,"
	echo "                    intermediate build files, and any compiled output"
	echo ""
	echo "  run           Automatically detect and run the appropriate simulation:"
	echo "                  - Runs ./main3d.gnu.MPI.ex if present (3D simulation)"
	echo "                  - Runs ./main2d.gnu.MPI.ex if present (2D simulation)"
	echo "                  - Runs ./main1d.gnu.MPI.ex if present (1D simulation)"
	echo "                  - Uses MPI with max number threads "
	echo " "       
	echo "  run screen    Run in the background and print output to screen"	
	echo "  visit         Create a .visit file listing all plotfiles in chronological order:"
	echo "                  - Searches for directories matching plotfile patterns (e.g., plt*, chk*)"
	echo "                  - Outputs a 'plotfiles.visit' file for use in VisIt"
	echo "                  - Useful for visualizing time series data across simulation steps"
	echo ""
	echo "  backup dname  Create an archive of the current simulation state:"
	echo "                  - requires a directory name: dname " 
	echo "                  - Includes: inputs file, screen log, plotfiles (e.g., plt*, chk*), and .visit file"
	echo "                  - Useful for saving results or transferring to another system"
	echo ""
	echo "  stepinfo      Extract and summarize key information from the screen log:"
	echo "                  - Computes average cost of last 5 coarse timesteps"
	echo "                  - Extracts number of MPI processes and max FAB memory usage"
	echo "                  - Sums number of cells advanced (latest per level)"
	echo "                  - Useful for profiling and performance tracking"
	echo "  check basic    Check if basic cerisse sane and not broken (slow)"
	echo "  check chem     Check if cerisse with PelePhysics sane and not broken (slow)"
	
	
	echo ""


    exit
esac


