# Simulation time
max_step  =  1500000
#max_step = 30010
stop_time =  0.5
cfl = 0.3
#time_step = 5.0e-7

cns.order_rk  = -2 
cns.stages_rk = 2

# Geometry 
geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  
geometry.prob_lo     = -0.078 -0.078  0.0   
geometry.prob_hi     =  0.078  0.078  0.24 

# BC
cns.lo_bc = 1 1 1
cns.hi_bc = 1 1 1 


# output screen
cns.verbose       = 1 # 0=quiet, 1=verbose
amr.v             = 1 # 0=quiet,1= verbose

# Refinement and regridding
amr.n_cell            = 104 104 160  ## 2 levels
amr.max_level         = 2      # maximum level number allowed
amr.ref_ratio         = 2      # refinement ratio per level
amr.regrid_int        = 100    # how often to regrid per level
amr.blocking_factor_x = 8      # blocking factor in x per level
amr.blocking_factor_y = 8      # blocking factor in y per level
amr.blocking_factor_z = 8
amr.max_grid_size_x   = 64     # maximum grid size in x per level
amr.max_grid_size_y   = 64     # maximum grid size in y per level
amr.max_grid_size_z   = 64
amr.n_error_buf       = 4      # number of buffer cells in error est
amr.grid_eff          = 0.7    # what constitutes an efficient grid

# Plot and checkpoint
amr.checkpoint_files_output = 1
amr.check_file              = ./check/chk     # root name of checkpoint file
amr.check_int               = 2000   # number of timesteps betw.  checkpoints
amr.restart =./chk130000
amr.plot_files_output = 1
amr.plot_file         = ./plot/plt    # root name of plotfile
amr.plot_int          = 2000         # number of timesteps between plotfiles
amr.derive_plot_vars  = pressure velocity temperature

eb2.geom_type = "custom"

eb2.eb_weight  = 1.0
eb2.redistribution_type = "FluxRedist"   #FluxRedist

# DIAGNOSTICS
amr.data_log = press_probes.log
cns.record_probe = 1 
cns.time_probe_lev = 0 
cns.time_probe_int = 1
cns.time_probes = p_flame p_comb p_atm
p_flame.field_name = pressure
p_flame.box_lo = -0.01 -0.01 0.065
p_flame.box_hi = 0.01 0.01 0.07
p_comb.field_name = pressure
p_comb.box_lo = -0.01 -0.01 0.12
p_comb.box_hi = 0.01 0.01 0.125
p_atm.field_name = pressure
p_atm.box_lo = -0.075 -0.01 0.14
p_atm.box_hi = -0.07 0.01 0.145

# Chemical Options
cns.reactor_type = "ReactorCvode"
#cns.reactor_type = "ReactorNull"
cvode.solve_type =  "GMRES"
ode.clean_init_massfrac = 1
cns.reaction_relax = 1.0
cns.max_react_temp = 2000.0

# ATF model
atf.thickening_factor = 5 
atf.laminar_flame_speed = 0.22
atf.laminar_flame_thickness = 0.0006206
atf.Cburn = 1426 
# STATS
cns.record_stats = 1


