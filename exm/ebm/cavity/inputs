# Simulation time
max_step  =  5000
stop_time =  0.5
cfl = 0.3
#time_step = 5.0e-7

cns.order_rk  = 3 
cns.stages_rk = 3

# Refluxing (important AMR)
cns.do_reflux = 1

# Geometry 
geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  
#geometry.prob_lo     = 0 -0.0002256
geometry.prob_lo = -0.0001900 -0.0002256
geometry.prob_hi = 0.0012972 0.0012616
#geometry.prob_hi     = 0.0012972  0.0010716 

# BC
cns.lo_bc = 2 2 
cns.hi_bc = 2 2  

cns.nscbc_lo   = 1 0 
cns.nscbc_hi   = 3 3
cns.nscbc_order = 2

# non reflecting inflow
cns.nscbc_xlo_utarget = 208.3500981
cns.nscbc_xlo_vtarget = 0.0
cns.nscbc_xlo_Ttarget = 300.0
cns.nscbc_xlo_eta = 1.0

# non reflecting outlow with target pressure
#cns.nscbc_xhi_Lchar   = 0.0014872
cns.nscbc_xhi_Lchar   = 0.00141
cns.nscbc_xhi_Mmax    = 0.6
cns.nscbc_xhi_Ptarget = 101325.0
cns.nscbc_xhi_sigma   = 0.28

#cns.nscbc_yhi_Lchar   = 0.00141
#cns.nscbc_yhi_Mmax    = 0.6
#cns.nscbc_yhi_Ptarget = 101325.0
#cns.nscbc_yhi_sigma   = 0.28

# output screen
cns.screen_output = 0 # 0=quiet, 1=verbose
cns.verbose       = 1 # 0=quiet, 1=verbose
amr.v             = 1 # 0=quiet,1= verbose

# Refinement and regridding
#amr.n_cell            = 544 544 
amr.n_cell            = 272 272 
amr.max_level         = 1     # maximum level number allowed
amr.ref_ratio         = 2      # refinement ratio per level
amr.regrid_int        = 10    # how often to regrid per level
amr.blocking_factor_x = 8      # blocking factor in x per level
amr.blocking_factor_y = 8      # blocking factor in y per level
amr.blocking_factor_z = 8
amr.max_grid_size_x   = 64     # maximum grid size in x per level
amr.max_grid_size_y   = 64     # maximum grid size in y per level
amr.max_grid_size_z   = 64
amr.n_error_buf       = 2      # number of buffer cells in error est
amr.grid_eff          = 0.7    # what constitutes an efficient grid

#Plot and checkpoint
amr.checkpoint_files_output = 0
amr.check_file              = ./checkpoint/chk     # root name of checkpoint file
amr.check_int               = 10000   # number of timesteps betw.  checkpoints
amr.plot_files_output = 1000
#amr.restart = chk110000
amr.plot_file         = ./plot/plt    # root name of plotfile
amr.plot_int          = 1       # number of timesteps between plotfiles
amr.derive_plot_vars  = pressure velocity temperature

eb2.geom_type = "custom"

eb2.eb_weight  = 1.0
eb2.redistribution_type = "FluxRedist"

# DIAGNOSTICS
amr.data_log = time_probe_react.log
cns.record_probe = 1 
cns.time_probe_lev = 0 
cns.time_probe_int = 1
cns.time_probes = xmom ymom rho
xmom.field_name = Xmom
xmom.box_lo = 0.000614  -0.000004
xmom.box_hi = 0.000620 0.000004
ymom.field_name = Ymom
ymom.box_lo = 0.000614  -0.000004
ymom.box_hi = 0.000620 0.000004
rho.field_name = Density
rho.box_lo = 0.000614  -0.000004
rho.box_hi = 0.000620 0.000004

# Chemical Options
#cns.reactor_type = "ReactorCvode"
cns.reactor_type = "ReactorNull"
cvode.solve_type =  "dense_direct"
ode.clean_init_massfrac = 1

# STATS
cns.record_stats = 1
