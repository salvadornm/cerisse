cns.stages_rk = 1

# Geometry 
geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  
geometry.prob_lo     = -0.078 -0.078  0.0   
geometry.prob_hi     =  0.078  0.078  0.24     

# BC
cns.lo_bc = 1 1 1
cns.hi_bc = 1 1 1 


# output screen
cns.verbose       = 1 # 0=quiet, 1=verbose
amr.v             = 1 # 0=quiet,1= verbose

# Refinement and regridding 
amr.n_cell            = 104 104 160 
