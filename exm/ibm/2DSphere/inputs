#------------------------------------------------------------------------------#
#                                 INPUT FILE
#------------------------------------------------------------------------------#
# start time is assumed to be 0, unless re-starting
max_step  = 100000
stop_time = 10.0
#time_step = 1.0e-5
cfl = 0.1

cns.order_rk  = -2 // -2, 1, 2 or 3
cns.stages_rk = 2 // 1, 2 or 3

# -1 = N/A (Incase of periodic)
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# 6 = user defined
cns.lo_bc = 1 2 
cns.hi_bc = 2 2 
cns.nstep_screen_output = 1 # 
cns.verbose = 1       # 0=quiet, 1=verbose

#-------------------------------- IMMERSED BOUNDARY ---------------------------#
ib.filename = circle1.dat circle2.dat circle3.dat circle4.dat circle5.dat circle6.dat circle7.dat 
ib.move = 0
ib.plot_surf = 1
ib.surf_file = ./plot/surf
ib.surf_int  = 2
#-------------------------------- COMPUTATIONAL DOMAIN ------------------------#
geometry.is_periodic = 0 0 
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     =   -1     -1
geometry.prob_hi     =   1       1
# Resolution note: 128^2 was too coarse for WENO-Z5 + IBM to handle the Mach-4
# shock / body interaction — the shock collapses onto ~0.2 cell across, which
# drives negative-density overshoot in the GP / Roe stencil near circle6.
# 512^2 resolves the shock on ~1 cell and the run is stable to stop_time.
amr.n_cell           =   512     512

#-------------------------------- REFINEMENT / REGRIDDING ---------------------#
amr.max_level       = 1  # maximum level number allowed
amr.ref_ratio       = 2  # refinement ratio
amr.regrid_int      = 20   # how often to regrid
amr.blocking_factor_x = 8  # blocking factor in x per level
amr.blocking_factor_y = 8  # blocking factor in x per level
#amr.blocking_factor_z = 8  # blocking factor in x per level
amr.max_grid_size_x   = 32   # maximum grid size in x per level
amr.max_grid_size_y   = 32   # maximum grid size in y per level
#amr.max_grid_size_z   = 32   # maximum grid size in z per level
amr.n_error_buf     = 2   # number of buffer cells in error est
amr.grid_eff        = 0.85     # what constitutes an efficient grid

#-------------------------------- PLOTFILES -----------------------------------#
amr.plot_files_output = 1
amr.plot_file         = ./plot/plt # root name of plotfile
amr.plot_int          = 5     # number of timesteps between plotfiles
amr.derive_plot_vars  = pressure velocity temperature
amr.v = 1 # 0=quiet, 1=verbose

amr.checkpoint_files_output = 1
amr.check_file              = chk    # root name of checkpoint file
amr.check_int               = 500    # number of timesteps between checkpoints
#amr.restart                 = chk31000
amrex.the_arena_is_managed=1 # NOTE: computing markers on CPU relies on this option
