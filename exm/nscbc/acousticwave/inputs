# Simulation time
# start time is assumed to be 0, unless re-starting
max_step  = 10000
stop_time = 0.008 # 0.001  equal to tr =0.34  0.003 (tr ~ 1)
cfl = 0.3
cns.order_rk  = -2
cns.stages_rk = 2

# Geometry 
geometry.is_periodic = 0 
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0.0    
geometry.prob_hi     = 1.0   

# -1 = N/A (Incase of periodic)
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# 6 = user defined
cns.lo_bc = 2 
cns.hi_bc = 2 
# NSCBC
cns.nscbc_lo   = 0 
cns.nscbc_hi   = 2 
cns.nscbc_order = 2

cns.screen_output   = 0 # 0=quiet, 1=verbose
cns.verbose         = 0 # 0=quiet, 1=verbose
amr.v               = 0

# Refinement and regridding 
amr.n_cell          = 256
amr.max_level       = 0     # maximum level number allowed
amr.ref_ratio       = 2  # refinement ratio per level
amr.regrid_int      = 2  # how often to regrid per level
amr.blocking_factor_x = 8  # blocking factor in x per level
amr.blocking_factor_y = 8  # blocking factor in x per level
amr.blocking_factor_z = 8  # blocking factor in x per level
amr.max_grid_size_x   = 32  # maximum grid size in x per level
amr.n_error_buf     = 0  # number of buffer cells in error est
amr.grid_eff        = 0.7     # what constitutes an efficient grid

#
fabarray.mfiter_tile_size = 8 8 8

# Plot and checkpoint
amr.checkpoint_files_output = 0
amr.check_file              = chk    # root name of checkpoint file
amr.check_int               = 100    # number of timesteps between checkpoints
amr.plot_files_output = 1
amr.plot_file         = ./plot/plt # root name of plotfile
amr.plot_int          = 100         # number of timesteps between plotfiles
amr.derive_plot_vars  = pressure velocity temperature

# DIAGNOSTICS
amr.data_log = probe.csv
cns.record_probe = 1
cns.time_probe_lev = 0
cns.time_probe_int = 1

cns.time_probes = PressureMAX PressureMIN Pprobe Uprobe
#
PressureMAX.field_name = pressure
PressureMAX.reduction  = max
PressureMAX.box_lo = 0.05
PressureMAX.box_hi = 0.95
#
PressureMIN.field_name = pressure
PressureMIN.reduction  = min
PressureMIN.box_lo = 0.05
PressureMIN.box_hi = 0.95
#
Pprobe.field_name = pressure
Pprobe.reduction  = average
Pprobe.box_lo = 0.795
Pprobe.box_hi = 0.805
#
Uprobe.field_name = velocity
Uprobe.reduction  = average
Uprobe.box_lo = 0.795
Uprobe.box_hi = 0.805





