PGlobalMAX.reduction  = max
PGlobalMAX.box_lo     = 0.0013 0.0
PGlobalMAX.box_hi     = 0.0117 0.013

PGlobalMIN.field_name = pressure
PGlobalMIN.reduction  = min
PGlobalMIN.box_lo     = 0.0013 0.0
PGlobalMIN.box_hi     = 0.0117 0.013

