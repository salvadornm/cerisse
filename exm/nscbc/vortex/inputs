# Simulation time
# start time is assumed to be 0, unless re-starting
max_step  = 1000
#stop_time =  0.044457
stop_time = 0.00013

time_step = 5e-8
#cfl = 0.3
cns.order_rk  = -2
cns.stages_rk = 2

# Geometry 
geometry.is_periodic = 0 1
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0.0     0.0
geometry.prob_hi     = 0.013   0.013

# BC
# -1 = N/A (Incase of periodic)
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# 6 = user defined
cns.lo_bc = 2 -1
cns.hi_bc = 2 -1
# NSCBC
cns.nscbc_lo   = 1 0
cns.nscbc_hi   = 3 0
cns.nscbc_order = 2
cns.nscbc_Lchar = 0.013
cns.nscbc_sigma = 0.28
cns.nscbc_use_transverse = 1
cns.nscbc_beta_transverse = 0.575
cns.nscbc_Mmax = 0.575


# inflow
cns.nscbc_utarget = 199.6335
cns.nscbc_vtarget = 0.0
cns.nscbc_Ttarget = 300.0
cns.nscbc_eta = 1.0

#
cns.nstep_screen_output = 100 # frequency of plotting information to screen
cns.verbose = 1       # 0=quiet, 1=verbose

# Refinement and regridding 
amr.n_cell          =128 128
amr.max_level       = 0     # maximum level number allowed
amr.ref_ratio       = 2 2 # refinement ratio per level
amr.regrid_int      = 2 2 # how often to regrid per level
amr.blocking_factor_x = 8 8 # blocking factor in x per level
amr.blocking_factor_y = 8 8 # blocking factor in x per level
amr.max_grid_size_x   = 64 64 # maximum grid size in x per level
amr.max_grid_size_y   = 64 64 # maximum grid size in y per level
amr.n_error_buf     = 0 0 # number of buffer cells in error est
amr.grid_eff        = 0.7     # what constitutes an efficient grid
amr.v               = 1
fabarray.mfiter_tile_size = 8 8

# Plot and checkpoint
amr.checkpoint_files_output = 0
amr.check_file              = chk    # root name of checkpoint file
amr.check_int               = 10000    # number of timesteps between checkpoints
amr.plot_files_output = 1
amr.plot_file         = ./plot/plt # root name of plotfile
amr.plot_int          = 100         # number of timesteps between plotfiles
amr.derive_plot_vars  = pressure velocity temperature

# =====================================================================
# DIAGNOSTICS: 2-D CONVECTING VORTEX
# =====================================================================

amr.data_log = probe_vortex.csv

cns.record_probe   = 1
cns.time_probe_lev = 0
cns.time_probe_int = 1

# Important:
# Keep this order unchanged 
#cns.time_probes = PGlobalMAX PGlobalMIN POutletMAX POutletMIN PCentre PUpper PLower
cns.time_probes = PGlobalMAX PGlobalMIN POutletMAX POutletMIN PCentre UCentre VCentre PUpper UUpper VUpper PLower ULower VLower

# ---------------------------------------------------------------------
# Global interior pressure extrema
#
# Exclude approximately 10% of the domain near the x boundaries.
# Used to measure pressure disturbances remaining after vortex exit.
# ---------------------------------------------------------------------

